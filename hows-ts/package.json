{
	"name": "http-over-websocket",
	"version": "0.0.2",
	"description": "A protocol that has HTTP/2-ish semantics to multiplex HTTP over a single WebSocket connection",
	"license": "MIT",
	"author": "termer",
	"type": "module",
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"repository": "https://github.com/termermc/http-over-websocket",
	"keywords": [
		"http",
		"websocket",
		"protocol",
		"tunnel",
		"compatibility",
		"http2",
		"grpc"
	],
	"scripts": {
		"test": "node --run build && node --test dist/src/*.test.js",
		"check": "tsc --noEmit",
		"build": "tsc",
		"fmt": "prettier --write .",
		"ci": "node --run fmt && node --run build && node --run test",
		"doPublish": "node --run ci && pnpm publish --access=public"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"typescript": "^7.0.2",
		"prettier": "^3.9.6"
	}
}
